    # ============================================
    # MySQL 数据库配置（重要！）
    # ============================================
    DB_ROOT_PASSWORD=root
    DB_DATABASE=mall
    DB_USER=mall
    DB_PASSWORD=root

  # ============================================
  # Redis 配置
  # ============================================
    REDIS_HOST=host.docker.internal        # Docker 内连接宿主机
      # REDIS_HOST=redis                    # 如果用 docker-compose 的 redis 服务
    REDIS_PORT=6379
    REDIS_PASSWORD=                        # 如果有密码就填，没有就留空


  # ============================================
  # RabbitMQ 配置
  # ============================================
  RABBITMQ_USER=guest
  RABBITMQ_PASSWORD=guest
  RABBITMQ_VHOST=/
